# ESP32-P4 (RISC-V) target configuration. Self-contained — the shared
# sdkconfig.defaults carries esp32-only keys, so this is passed on its own:
#   idf.py -B build-p4 -DSDKCONFIG=sdkconfig.esp32p4 \
#          -DSDKCONFIG_DEFAULTS=sdkconfig.defaults.esp32p4 -DIDF_TARGET=esp32p4 build
CONFIG_IDF_TARGET="esp32p4"

# Build for performance (the 68k interpreter is dispatch-bound).
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y

# PSRAM holds the 2 MB emulated RAM + the ROM image. Keep the internal-RAM
# reserve small so the JIT executable cache gets a large contiguous block.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=8192

# Flash + the custom partition table (3 MB app + FAT storage).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# FAT long filenames for the PRC/PDB installer.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
