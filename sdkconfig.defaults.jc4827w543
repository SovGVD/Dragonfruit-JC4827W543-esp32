CONFIG_IDF_TARGET="esp32s3"
CONFIG_BOARD_JC4827W543=y
CONFIG_TOUCH_XPT2046=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y
# The 68k JIT writes native code into internal RAM and runs it from there, which
# needs an executable heap; S3 memory protection (PMS) forbids that.
# CONFIG_ESP_SYSTEM_MEMPROT is not set
# JC4827W543 N4R8: 4 MB flash, 8 MB octal PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# Keep UART0 for the existing debug console and serial HotSync bridge.
# USB Serial/JTAG provides a second copy of boot/log output on native USB.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Internal Palm serial PPP -> Wi-Fi, with a Palm-only setup portal.
CONFIG_PALM_WIFI_GATEWAY=y
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_SERVER_SUPPORT=y
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
# CONFIG_LWIP_PPP_ENABLE_IPV6 is not set
# CONFIG_LWIP_PPP_VJ_HEADER_COMPRESSION is not set
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
# Use PSRAM for eligible Wi-Fi/lwIP allocations; DMA buffers remain internal.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Internal RAM is the tight resource on this board: the 68k JIT cache, task
# stacks, SD and LCD DMA and Wi-Fi all need it. Large static buffers that are
# never touched with the flash cache off are marked EXT_RAM_BSS_ATTR and live
# in PSRAM; only small allocations prefer internal RAM.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Wi-Fi only carries Palm PPP at serial speed: fewer buffers, no aggregation,
# and its fast-path code stays in flash instead of internal RAM.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# Leave room for Wi-Fi and the task stacks after the JIT takes its cache.
CONFIG_M68K_JIT_KEEP_INTERNAL_KB=128
