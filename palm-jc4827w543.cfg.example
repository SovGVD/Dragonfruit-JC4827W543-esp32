# Copy to the FAT32 SD root as palm.cfg. Optional: this layout is the
# automatic portrait default for the JC4827W543 (USB connector at bottom).
preset = jc4827w543

# The debug console / serial HotSync transport uses UART0, 115200 baud.
# Keep console mode unless using a physical UART0 serial HotSync connection.
serial.mode = console
serial.baud = 57600

# Restore apps/data/settings through a normal Palm warm boot. Save when Palm
# goes to sleep (BOOT or Palm auto-off); no timed saves during active use.
state.enabled = 1

# For individual element placement use preset=custom and palm.cfg.example.
# Native panel coordinates, x=0..479, y=0..271; rotation 0 is upright.
# The portrait preset renders the LCD at native 160x160 (1:1), with no enlargement.

# Resistive XPT2046 calibration. Starting values; tune to your panel.
# Raw X = D0 ADC, raw Y = 90 ADC. Min/max apply AFTER swap_xy.
# Pixel inversion is applied after mapping min..max to 0..width/height-1.
touch.x_min = 200
touch.x_max = 3900
touch.y_min = 200
touch.y_max = 3900
touch.swap_xy = 0
touch.invert_x = 1
touch.invert_y = 1
touch.pressure_min = 400
# Set to 1 to log raw coordinates at most 5 times/second while drawing.
touch.log_raw = 0
